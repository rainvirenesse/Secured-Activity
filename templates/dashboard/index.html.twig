{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: 50px auto; padding: 20px; font-family: Arial, sans-serif;">
    <h1>Dashboard</h1>
    
    {% if is_granted('ROLE_ADMIN') %}
        <p><strong>Admin: You are logged in as Admin. You have full access.</strong></p>
    {% elseif is_granted('ROLE_USER') %}
        <p><strong>User: You are logged in as Regular User. Limited access granted.</strong></p>
    {% endif %}
</div>
{% endblock %}